PORT=3000
JWT_SECRET=replace_with_strong_secret

# --- Local PostgreSQL (used when DATABASE_URL is not set) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=content_system
DB_PASSWORD=
DB_PORT=5432

# --- Hosted PostgreSQL (Render / Railway / Supabase / etc.) ---
# When set, this overrides the DB_* vars above and connects via SSL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Optional AWS S3 (uploads go to disk if not set) ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_bucket_name
